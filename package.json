{
  "name": "@rcpthongta/string-utils",
  "version": "0.0.1",
  "description": "A lightweight and type-safe string utility library for TypeScript and Node.js",
  "author": "rcpthongta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcpthongta/string-utils.git"
  },
  "bugs": {
    "url": "https://github.com/rcpthongta/string-utils/issues"
  },
  "homepage": "https://github.com/rcpthongta/string-utils#readme",
  "keywords": [
    "node",
    "javascript",
    "typeScript",
    "string",
    "utils",
    "string-utils",
    "helpers",
    "string-helpers"
  ],
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "npm run build:clean && tsup && npm run build:types",
    "build:types": "tsc -p tsconfig.types.json",
    "build:clean": "rimraf dist",
    "lint": "eslint **/*.{*rc,cjs,js,json,json5,jsonc,jsonl,md,mjs,yaml,yml}",
    "lint:fix": "eslint --fix **/*.{*rc,cjs,js,json,json5,jsonc,jsonl,md,mjs,yaml,yml}"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/markdown": "^7.5.1",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^2.21.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-yml": "^1.19.1",
    "globals": "^17.9.0",
    "jsonc-eslint-parser": "^2.4.2",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
