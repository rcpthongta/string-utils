{
  "version": "0.0.1",
  "name": "string-utils",
  "description": "A lightweight, type-safe, dependency-free string utility library for TypeScript and modern JavaScript applications.",
  "author": "rcpthongta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcpthongta/string-utils.git"
  },
  "bugs": {
    "url": "https://github.com/rcpthongta/string-utils/issues"
  },
  "keywords": [
    "string",
    "string-utils",
    "string-library",
    "string-helpers"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "unpkg": "./dist/iife/index.global.js",
  "jsdelivr": "./dist/iife/index.global.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:js && npm run build:types",
    "build:clean": "rimraf dist",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.types.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
